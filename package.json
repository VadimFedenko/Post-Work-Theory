{
  "name": "after-work-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-web.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:data && tsc -b && vite build",
    "build:pages": "npm run build -- --base=/Post-Work-Theory/",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "~5.9.3", "vite": "^7.2.0" },
  "engines": { "node": ">=22.12.0" }
}
