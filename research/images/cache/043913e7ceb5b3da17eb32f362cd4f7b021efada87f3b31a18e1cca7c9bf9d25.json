      {
        "pageid": 14472345,
        "ns": 0,
        "title": "The Veldt (short story)",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/commons/6/69/Ray_Bradbury_%281975%29_-cropped-.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 1056,
          "height": 1296
        },
        "pageimage": "Ray_Bradbury_(1975)_-cropped-.jpg",
        "extract": "\"The Veldt\" is a science fiction short story by American author Ray Bradbury. Originally appearing as \"The World the Children Made\" in the September 23, 1950, issue of The Saturday Evening Post, it was republished under its current name in the 1951 anthology The Illustrated Man.\nIn the story, a mother and father struggle with their technologically advanced home taking over their role as parents, and their children becoming uncooperative as a result of their lack of discipline.",
        "pageprops": {
          "defaultsort": "Veldt, The",
