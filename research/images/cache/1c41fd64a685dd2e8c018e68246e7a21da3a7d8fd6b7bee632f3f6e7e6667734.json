        "title": "Friday",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/commons/2/22/Friday_Abbr_GW.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 553,
          "height": 555
        },
        "pageimage": "Friday_Abbr_GW.png",
        "extract": "Friday is the day of the week between Thursday and Saturday. In countries adopting the \"Monday-first\" convention it is the fifth day of the week. In countries that adopt the \"Sunday-first\" convention, it is the sixth day of the week. \nIn most Western countries, Friday is the fifth and final day of the working week. In some other countries, Friday is the first day of the weekend, followed by Saturday.\nIn Israel, Friday is the sixth day of the week. In Iran, Friday is the last day of the weekend, with Saturday as the first day of the working week.",
        "pageprops": {
          "page_image_free": "Friday_Abbr_GW.png",
          "wikibase-shortdesc": "Day of the week",
          "wikibase_item": "Q130"
        },
        "contentmodel": "wikitext",
        "pagelanguage": "en",
