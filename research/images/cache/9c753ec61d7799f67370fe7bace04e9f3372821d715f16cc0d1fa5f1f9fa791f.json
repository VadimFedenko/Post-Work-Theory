      {
        "pageid": 1752503,
        "ns": 0,
        "title": "Autofac",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/commons/9/90/Galaxy_195511.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 351,
          "height": 460
        },
        "pageimage": "Galaxy_195511.jpg",
        "extract": "\"Autofac\" is a 1955 science fiction novelette by American writer Philip K. Dick that features one of the earliest treatments of self-replicating machines (and Dick's second, after his 1953 novelette Second Variety). It originally appeared in the November 1955 issue of Galaxy Science Fiction, and was reprinted in several collections, including The Variable Man published in 1957, and Robots, Androids, and Mechanical Oddities published in 1984.\nIt was adapted by Travis Beacham for an episode of the 2017 TV series, Philip K. Dick's Electric Dreams, with the same name as the short story.",
        "pageprops": {
          "displaytitle": "<i>Autofac</i>",
          "page_image_free": "Galaxy_195511.jpg",
          "wikibase-shortdesc": "1955 science fiction short story by Philip K. Dick",
          "wikibase_item": "Q387362"
        },
        "contentmodel": "wikitext",
        "pagelanguage": "en",
        "pagelanguagehtmlcode": "en",
        "pagelanguagedir": "ltr",
        "touched": "2026-10-15T21:53:55Z",
        "lastrevid": 1375781560,
        "length": 6715,
        "fullurl": "https://en.wikipedia.org/wiki/Autofac",
        "editurl": "https://en.wikipedia.org/w/index.php?title=Autofac&action=edit",
        "canonicalurl": "https://en.wikipedia.org/wiki/Autofac"
      },
      {
        "pageid": 3240689,
        "ns": 0,
        "title": "The Old Man in the Cave",
        "extract": "\"The Old Man in the Cave\" is the 127th episode of the American television anthology series The Twilight Zone. It is set in a post-apocalyptic 1974, ten years after a nuclear holocaust in the United States. The episode is a cautionary tale about humanity's greed and the danger of questioning one's faith in forces greater than oneself.",
        "pageprops": {
          "defaultsort": "Old Man in the Cave, The",
          "wikibase-shortdesc": "7th episode of the 5th season of The Twilight Zone",
          "wikibase_item": "Q2783258"
        },
