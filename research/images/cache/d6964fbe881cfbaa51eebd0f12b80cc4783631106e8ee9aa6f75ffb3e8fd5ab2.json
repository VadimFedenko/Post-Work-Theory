        "title": "Vacuum Flowers",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/f/f1/VacuumFlowers.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 255,
          "height": 383
        },
        "pageimage": "VacuumFlowers.jpg",
        "extract": "Vacuum Flowers is a science fiction novel by American writer Michael Swanwick, published in 1987.  It is an early example of the cyberpunk genre, and features one of the earliest uses of the concept of wetware.",
        "pageprops": {
