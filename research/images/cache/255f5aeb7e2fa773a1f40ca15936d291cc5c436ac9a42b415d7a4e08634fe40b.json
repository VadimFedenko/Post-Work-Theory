      {
        "pageid": 25945824,
        "ns": 0,
        "title": "Freedom™",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/e/eb/FreedomTMCoverMedium.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 257,
          "height": 388
        },
        "pageimage": "FreedomTMCoverMedium.jpg",
        "extract": "Freedom™ is a science fiction action novel, the sequel to Daemon, by American writer Daniel Suarez. It continues the story of a distributed, persistent computer application, known as The Daemon, that begins to change the real world after the original programmer's death.",
