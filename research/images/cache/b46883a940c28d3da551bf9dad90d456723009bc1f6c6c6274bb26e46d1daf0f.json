      {
        "pageid": 521188,
        "ns": 0,
        "title": "Down and Out in the Magic Kingdom",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/4/49/Downandout.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 192,
          "height": 280
        },
        "pageimage": "Downandout.jpg",
        "extract": "Down and Out in the Magic Kingdom is a 2003 science fiction book, the first novel by Canadian author and digital-rights activist Cory Doctorow. It depicts people competing over how new technology is being used at Walt Disney World, in a post-scarcity world with an economy based on reputation. Concurrent with its publication by Tor Books, Doctorow released the entire text of the novel under a Creative Commons noncommercial license on his website, allowing the whole text of the book to be freely read and distributed without needing any further permission from him or his publisher.\nThe novel was nominated for the Nebula Award for Best Novel in 2004.",
        "pageprops": {
          "displaytitle": "<i>Down and Out in the Magic Kingdom</i>",
          "page_image": "Downandout.jpg",
          "wikibase-shortdesc": "2003 science fiction book by Cory Doctorow",
