      {
        "pageid": 9796250,
        "ns": 0,
        "title": "Dreamfall Chapters",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/c/c9/Dreamfall_Chapters_cover.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 315,
          "height": 177
        },
        "pageimage": "Dreamfall_Chapters_cover.jpg",
        "extract": "Dreamfall Chapters is an episodic 3D adventure game with emphasis on character interaction, exploration of the game world, and puzzle solving. It is a sequel to the adventure games The Longest Journey and Dreamfall: The Longest Journey. The game was released for PC in five episodes between 21 October 2014 and 17 June 2016. The updated \"Final Cut\" version was released on physical media for PlayStation 4 and Xbox One on 5 May 2017, and the Microsoft Windows, OS X, and Linux versions on 21 July 2017.\nThe Longest Journey series is set in two parallel universes: Stark, a cyberpunk future Earth, and Arcadia, its magical fantasy counterpart. Chapters...",
        "pageprops": {
          "displaytitle": "<i>Dreamfall Chapters</i>",
          "page_image": "Dreamfall_Chapters_cover.jpg",
          "wikibase-shortdesc": "2017 episodic 3D adventure video game",
