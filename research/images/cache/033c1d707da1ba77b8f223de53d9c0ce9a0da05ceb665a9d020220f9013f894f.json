      {
        "pageid": 9394422,
        "ns": 0,
        "title": "Extras (novel)",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/8/84/Extrascover1.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 270,
          "height": 371
        },
        "pageimage": "Extrascover1.jpg",
        "extract": "Extras is a young adult science fiction novel written by Scott Westerfeld. The novel was published and released by Simon & Schuster on October 2, 2007, and is a companion book to the Uglies series. However, Extras differs from its predecessors in that its protagonist is fifteen-year-old Aya Fuse, not Tally Youngblood. Tally is not the main character but still appears in the book's later chapters in a major role.\nThe book was generally received well by critics.",
        "pageprops": {
          "displaytitle": "<i>Extras</i> (novel)",
