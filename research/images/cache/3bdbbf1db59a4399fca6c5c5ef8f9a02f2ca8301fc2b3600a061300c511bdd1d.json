      {
        "pageid": 30020699,
        "ns": 0,
        "title": "The Quantum Thief",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/0/0f/The_Quantum_Thief.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 250,
          "height": 386
        },
        "pageimage": "The_Quantum_Thief.jpg",
        "extract": "The Quantum Thief is the debut science fiction novel by Finnish writer Hannu Rajaniemi and the first novel in a trilogy featuring the character of Jean le Flambeur; the sequels are The Fractal Prince (2012) and The Causal Angel (2014). The novel was published in Britain by Gollancz in 2010, and by Tor in 2011 in the US. It is a heist story, set in a futuristic Solar System, that features a protagonist modeled on Arsène Lupin, the gentleman thief of Maurice Leblanc.\nThe novel was nominated for the 2011 Locus Award for Best First Novel, and was second runner-up for the 2011 Campbell Memorial Award.",
        "pageprops": {
          "defaultsort": "Quantum Thief, The",
          "displaytitle": "<i>The Quantum Thief</i>",
