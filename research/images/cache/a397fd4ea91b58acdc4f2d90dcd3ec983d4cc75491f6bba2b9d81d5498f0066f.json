        "title": "Turn A Gundam",
        "original": {
          "source": "https://upload.wikimedia.org/wikipedia/en/a/aa/TURNAGUNDAMPoster.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
          "width": 265,
